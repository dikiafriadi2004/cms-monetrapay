# ============================================================
# .env template untuk VPS Docker deployment
# Copy file ini: cp .env.docker .env
# Lalu isi semua value yang belum diisi
# ============================================================

APP_NAME="CMS"
APP_ENV=production
APP_KEY=                          # Jalankan: docker compose exec app php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_PORT=80                       # Port yang di-expose ke host

# ============================================================
# CARA INSTALL:
#
# LOCAL (XAMPP/artisan serve):
#   Jalankan: php artisan cms:install
#   Command itu akan tanya nama/email/password via terminal.
#
# VPS DOCKER:
#   JANGAN simpan credentials di file ini.
#   Inject via environment saat deploy:
#
#   docker compose exec app php artisan cms:install \
#     --admin-name="Super Admin" \
#     --admin-email="admin@domain.com" \
#     --admin-password="Admin@2024!"
#
#   Atau via docker-compose environment (tidak di-commit):
#   ADMIN_EMAIL=admin@domain.com
#   ADMIN_PASSWORD=Admin@2024!
#   ADMIN_NAME=Super Admin
# ============================================================

# Database (harus sama dengan MYSQL_* di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db                        # Nama service di docker-compose
DB_PORT=3306
DB_DATABASE=cms_db
DB_USERNAME=cms_user
DB_PASSWORD=SecureDBPass123!      # Ganti dengan password yang kuat
DB_ROOT_PASSWORD=SecureRootPass!  # Untuk MySQL root (docker-compose)

# Redis (Cache + Queue + Session)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis                  # Nama service di docker-compose
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail / SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                    # Email Gmail kamu
MAIL_PASSWORD=                    # App Password Gmail (16 karakter)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error                   # production: error saja

# Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true        # true untuk HTTPS

# Filesystem
FILESYSTEM_DISK=public
